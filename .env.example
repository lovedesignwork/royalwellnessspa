# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Pay Solutions hosted payment + authenticated payment inquiry
# Enable only after merchant dashboard return/postback settings are verified
PAYSOLUTIONS_ENABLED=false
PAYSOLUTIONS_MERCHANT_ID=
PAYSOLUTIONS_API_KEY=
PAYSOLUTIONS_SECRET_KEY=
# Server-only access to the shared RPCH reservations table
RPCH_SUPABASE_SERVICE_ROLE_KEY=

# Legacy 2C2P callback verification (new checkout uses Pay Solutions)
TWOC2P_MERCHANT_ID=your_2c2p_merchant_id
TWOC2P_SECRET_KEY=your_2c2p_secret_key
TWOC2P_SANDBOX=true

# App Configuration
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Resend Email (for contact form)
RESEND_API_KEY=your_resend_api_key
